[Unit]
Description=AdHoc Relay: the meeting of two TCP connections in the NAT of this computer
# after whatever loads the firewall: their rules first, then these
After=network-online.target nftables.service iptables.service firewalld.service ufw.service docker.service
Wants=network-online.target

[Service]
# the rules, then `give`, which answers the requests for a port, keeps the records and writes the reports; a reload loads the
# rules again and `give` reads the settings
# again - the meetings going on go on. ${FIXED}, ${RECORDS} and ${ALIASES}: one argument each, the spaces in them too
Type=simple
EnvironmentFile=/etc/adhoc-relay.conf
ExecStartPre=/usr/libexec/adhoc-relay/rules load ${PASSWORD} ${FIRST} ${LAST} ${WAIT} ${TRIES} ${BLOCK} ${GUARD} ${SHORT} ${GUESSES} ${FIXED} ${RECORDS} ${ALIASES}
ExecStart=/usr/bin/perl /usr/libexec/adhoc-relay/give.pl
ExecReload=/usr/libexec/adhoc-relay/rules load ${PASSWORD} ${FIRST} ${LAST} ${WAIT} ${TRIES} ${BLOCK} ${GUARD} ${SHORT} ${GUESSES} ${FIXED} ${RECORDS} ${ALIASES}
ExecReload=/bin/kill -HUP $MAINPID
ExecStopPost=/usr/libexec/adhoc-relay/rules unload
Restart=on-failure

[Install]
WantedBy=multi-user.target
