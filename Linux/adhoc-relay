my @SETTINGS = (
    [PASSWORD => 'Password', '16 letters or digits. Servers ask for a port with it. After a change, give every server its new line',
        sub { $_[0] =~ /^[A-Za-z0-9]{16}$/ ? undef : '16 letters and digits, or new' }, 'Basic'],
    [ADDRESS => 'DNS name', 'Optional. A name in DNS that points to this computer, or its IP: the lines carry it. auto - the public IP, found automatically',
        sub { $_[0] eq 'auto' || $_[0] =~ /^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$/ ? undef : 'a name in DNS, an IPv4 address, or auto' }, 'Basic'],
    [FIRST => 'First port', 'Servers ask this port for a port. The ports after it, up to the last, are given to servers',
        sub { $_[0] =~ /^\d+$/ && $_[0] >= 1 && $_[0] < $conf{LAST} ? undef : "a port below the last, $conf{LAST}" }, 'Ports'],
    [LAST => 'Last port', 'A firewall or a router in front of this computer must let the range through, TCP and UDP',
        sub { $_[0] =~ /^\d+$/ && $_[0] > $conf{FIRST} && $_[0] <= 65535 ? undef : "a port above the first, $conf{FIRST}" }, 'Ports'],
    [WAIT => 'Hold, seconds', 'How long a server keeps its port after its last knock: 10 s more than Knock at least, so a knock that comes late loses nothing',
        sub { $_[0] =~ /^\d+$/ && $_[0] >= 30 && $_[0] >= ($conf{KNOCK} // 20) + 10 ? undef : '30 or more, and 10 more than Knock, ' . ($conf{KNOCK} // 20) }, 'Ports'],
    [KNOCK => 'Knock, seconds', 'How often a server knocks, to keep its port open. Its NAT must keep the mapping of a knock till the next one: most keep it 30 s or more, some less. A knock is a small part of what a waiting server costs this computer',
        sub { $_[0] =~ /^\d+$/ && $_[0] >= 5 && $_[0] <= 120 && $_[0] + 10 <= ($conf{WAIT} // 60) ? undef : '5 to 120, and 10 less than Hold, ' . ($conf{WAIT} // 60) . ', at most' }, 'Servers'],
    [DIAL => 'Dial try, seconds', 'How long a try of dialing of a server is: 3, 7, 15 or 31. Its system sends the SYN again within it, after 1, 3, 7 and 15 s, and this computer looks at each SYN: 31 sends a quarter of the SYNs of 3 - a third from Windows, which ends a try at 21 s -, the most of what a waiting server costs. A server started again on the same port takes it back at once behind a NAT that keeps its port, as most do; behind one that does not, in about half the try',
        sub { $_[0] =~ /^(3|7|15|31)$/ ? undef : '3, 7, 15 or 31' }, 'Servers'],
    [REBIND => 'Rebind, minutes', 'How often a server binds again. Each bind is work for this computer, as much as a few hundred SYNs. A server binds again at once when its knock is refused, and after its port refused it three times: a firewall that drops what comes to a closed port, not refuses it, lets a server find that this computer forgot its port only at its next bind. The key of the knocks of a server lives two times that, and a server stopped without a word is forgotten then',
        sub { $_[0] =~ /^\d+$/ && $_[0] >= 1 && $_[0] <= 60 ? undef : '1 to 60' }, 'Servers'],
    [TRIES => 'Wrong tries', 'Requests and knocks with a wrong password or key, per address. One more is allowed each minute; past them the address is blocked',
        sub { $_[0] =~ /^\d+$/ && $_[0] >= 1 && $_[0] <= 1000 ? undef : '1 to 1000' }, 'Protection'],
    [BLOCK => 'Block, seconds', 'How long a blocked address is ignored',
        sub { $_[0] =~ /^\d+$/ && $_[0] >= 1 ? undef : 'seconds, 1 or more' }, 'Protection'],
    [GUARD => 'Stop password guessing', 'on: an address that makes too many short connections to a port is blocked at that port. off: only for a service whose connections are short by nature',
        sub { $_[0] =~ /^[01]$/ ? undef : 'on or off' }, 'Protection'],
    [SHORT => 'Short, seconds', 'A connection that ends sooner counts as a password tried and refused',
        sub { $_[0] =~ /^\d+$/ && $_[0] >= 1 && $_[0] <= 3600 ? undef : '1 to 3600' }, 'Protection'],
    [GUESSES => 'Short connections', 'Allowed per address and port. One more is allowed each 10 minutes; past them the address is blocked at that port',
        sub { $_[0] =~ /^\d+$/ && $_[0] >= 1 && $_[0] <= 1000 ? undef : '1 to 1000' }, 'Protection'],
    [CONNECTIONS => 'Connections per address', 'Connections one address may have through this computer at once. One more meets nobody until one of them ends. 0: any number. Several people behind one public address count as one address',
        sub { $_[0] =~ /^\d+$/ && $_[0] <= 1000 ? undef : '0 to 1000' }, 'Protection'],
);

# the key of a setting in the menu: 1 to 9, then 0, then a, b
sub setting_key { $_[0] < 10 ? $_[0] : $_[0] == 10 ? 0 : chr(ord('a') + $_[0] - 11) }

sub settings_show {
    title('Settings');
    my ($n, $group) = (0, '');
    for (@SETTINGS) {
        my ($k, $words, $about, undef, $g) = @$_;
        if ($g ne $group) { section($group = $g) }
        my $v = $k eq 'PASSWORD' ? (($utf ? "\x{2022}" : '*') x length($conf{$k} // '')) : $conf{$k} // '';
        $v = 'auto' if $k eq 'ADDRESS' && $v eq '';
        $v = $v ? 'on' : 'off' if $k eq 'GUARD';
        print '   ', ($IN_MENU ? chip(setting_key(++$n)) . ' ' : ''), paint(sprintf('%-24s', $words), 'name'), paint($v eq '' ? '-' : $v, 'good'), "\n";
        print '   ', ($IN_MENU ? '    ' : ''), paint($_, 'quiet'), "\n" for wrap($about, width() - 8);
    }
    section('Uninstall');
    print '   ', paint('Removes AdHoc Relay from this computer, its settings too: sudo sh adhoc-relay-linux.sh remove', 'quiet'), "\n";
}

# a setting changed, checked, saved and loaded: by its name in the file or its number
sub set_cmd {
    my ($which, $v) = @_;
    my ($s) = grep { $which =~ /^\d+$/ ? $_ == $SETTINGS[$which - 1] : uc($which) eq $_->[0] } @SETTINGS;
    fail('adhoc-relay set <setting> <value>; the settings: ' . join(' ', map { lc $_->[0] } @SETTINGS)) unless $s && defined $v;
    my ($k, $words, $about, $check) = @$s;
    return password('new') if $k eq 'PASSWORD' && $v eq 'new';
    $v = { on => 1, off => 0 }->{lc $v} // $v if $k eq 'GUARD';
    my $bad = $check->($v);
    fail("$words: $bad") if $bad;
    return address_cmd($v) if $k eq 'ADDRESS';
    if ($k eq 'PASSWORD') {
        # `rules` leaves out what has the key of the password: a fixed port, a record, a user would open nothing
        fail("$words: it is a key of this computer already") if grep { $_ eq $v } (map { $_->{key} } fixed(), users()), (map { ($_->{write}, @{$_->{reads}}) } records());
    } else {
        # a number as a number: zeros in front would make it one of base 8 for nft
        $v += 0;
        fail("$words: " . ($k eq 'WAIT' || $k eq 'BLOCK' ? '86400 at most, a day' : 'too large')) if ($k eq 'WAIT' || $k eq 'BLOCK') && $v > 86400;
    }
    # as it is already: nothing to load
    return note('quiet', "$words: as it is") if $v eq ($conf{$k} // '');
    set($k, $v);
    apply();
    note('good', "$words: " . ($k eq 'GUARD' ? ($v ? 'on' : 'off') : $v));
    if ($k eq 'FIRST' || $k eq 'LAST') {
        my @out = grep { $_->{port} <= $conf{FIRST} || $_->{port} > $conf{LAST} } fixed();
        note('warn', 'A fixed port out of the range opens nothing now: ' . join(' ', map { $_->{port} } @out)) if @out;
        note('warn', 'The lines of the servers have the new first port: give every server its new line') if $k eq 'FIRST';
    }
}

# The log of the last 10 minutes, turned on or off: its rules are loaded or left out. Off unless asked for - each note is one
# more write at a knock, a request, a SYN
sub log_cmd {
    my ($to) = @_;
    if (!defined $to) {
        note('quiet', 'The log of the last 10 minutes is ' . ($conf{LOG} ? 'on: adhoc-relay status shows it; adhoc-relay log off turns it off' : 'off: adhoc-relay log on turns it on, for finding out why something does not work'));
        return;
    }
    fail('adhoc-relay log [on | off]') unless $to =~ /^(on|off)\z/;
    my $v = $to eq 'on' ? 1 : 0;
    return note('quiet', "The log: as it is, $to") if $v == ($conf{LOG} ? 1 : 0);
    set('LOG', $v);
    apply();
    note('good', $v ? 'The log is on: what comes from now on is in adhoc-relay status. Turn it off when done: adhoc-relay log off' : 'The log is off: nothing is noted');
}

# an address blocked let in again: blocked for wrong requests, or - with the port - at that port for guessing passwords there
sub unblock_cmd {
    my ($address, $port) = @_;
    fail('adhoc-relay unblock <address> [<port>]: an address of Blocked addresses, and the port when it is blocked at one')
        unless defined $address && $address =~ /^\d{1,3}(?:\.\d{1,3}){3}\z/ && (!defined $port || $port =~ /^\d{1,5}\z/);
    my $done = system('/usr/libexec/adhoc-relay/rules', 'unblock', $address, defined $port ? $port : ()) == 0;
    note($done ? 'good' : 'warn', $done ? "$address is let in again" . (defined $port ? " at port $port" : '') : "$address is not blocked" . (defined $port ? " at port $port" : ''));
}

# ── the menu: what a person does here, one screen each, as the tabs of the page of a router ──

# a question; Enter - `default`
sub ask {
    my ($q, $default) = @_;
    print "\n ", paint("$BOX{arrow} $q", 'news'), (defined $default && $default ne '' ? paint(" [$default]", 'quiet') : ''), ' ';
    my $a = <STDIN>;
    exit 0 unless defined $a;
    utf8::decode($a);
    $a =~ s/^\s+|\s+$//g;
    return $a eq '' ? $default : $a;
}

# One key pressed, no Enter after it: the terminal raw for it. Enter - "\n", Escape and the keys of arrows - "\e"; Ctrl+C and
# Ctrl+D end. Without a terminal, the next line.
sub key {
    my ($q) = @_;
    print "\n ", paint("$BOX{arrow} $q", 'news'), ' ' if defined $q;
    unless (-t STDIN) {
        my $l = <STDIN>;
        exit 0 unless defined $l;
        $l =~ s/^\s+|\s+$//g;
        return $l eq '' ? "\n" : $l;
    }
    require POSIX;
    # the terminal as it was, whole - its flags and its times of reading -, put back whatever ends the wait: a key, the end of
    # the input, a signal. Ctrl+C comes as a key, not as a signal that would leave the terminal without its echo
    my $was = POSIX::Termios->new;
    $was->getattr(0);
    my $t = POSIX::Termios->new;
    $t->getattr(0);
    $t->setlflag($t->getlflag & ~(POSIX::ECHO() | POSIX::ICANON() | POSIX::ISIG()));
    $t->setcc(POSIX::VMIN(), 1);
    $t->setcc(POSIX::VTIME(), 0);
    local $SIG{TERM} = local $SIG{HUP} = sub { $was->setattr(0, POSIX::TCSANOW()); exit 143 };
    $t->setattr(0, POSIX::TCSANOW());
    my $got = sysread STDIN, my $c, 1;
    # the rest of a key that sends several bytes, an arrow: taken away
    if ($got && $c eq "\e") {
        $t->setcc(POSIX::VMIN(), 0);
        $t->setcc(POSIX::VTIME(), 1);
        $t->setattr(0, POSIX::TCSANOW());
        1 while sysread STDIN, my $more, 8;
    }
    $was->setattr(0, POSIX::TCSANOW());
    print "\n" if defined $q;
    # nothing read: the terminal is gone - the end, not a menu drawn again and again
    exit 0 if !$got || $c eq "\x04" || $c eq "\x03";
    return $c eq "\r" ? "\n" : $c;
}

# the window cleared: a screen of the menu starts at its top
sub clear { print "\e[H\e[2J" if $colour && -t STDIN }

# what an action said stays until a key: the screen is drawn anew after it
sub pause { key('Press any key') }

# an action of a screen: what fails is said, not the end of the menu; what it said is read before the screen comes again
sub act {
    my ($what) = @_;
    eval { $what->(); 1 } or note('bad', $@ =~ s/\s+$//r);
    pause();
}

# the first free port from the first + 1000 on: easy to remember
sub free_port {
    my %taken = map { $_->{port} => 1 } fixed();
    my $p = $conf{FIRST} + 1000 <= $conf{LAST} ? $conf{FIRST} + 1000 : $conf{FIRST} + 1;
    $p++ while $taken{$p} && $p < $conf{LAST};
    return $p;
}

