# ── adhoc-relay api: for a program that sets this computer up from afar, over SSH ──
# The same JSON as `adhoc-relay api` of an OpenWrt router: a program needs not know which of the two the relay is. The form of it is
# in the README, section API. `api get` - everything; `api set` - the parts given on the standard input replace those there are, a
# part left out stays; checked first, nothing written when something is wrong: `{ "error": ... }` and the code 1.

# JSON by hand: perl-base of Debian has no module for it. A number is blessed 'N', true and false are \1 and \0
# what is no number - a line of the settings changed by hand - is 0: the JSON stays JSON
sub N { my $v = shift; $v = ($v // '') =~ /\A-?\d+(?:\.\d+)?\z/ ? $v + 0 : 0; bless \$v, 'N' }
sub json_out {
    my ($v) = @_;
    return 'null' unless defined $v;
    my $r = ref $v;
    return ${$v} if $r eq 'N';
    return $$v ? 'true' : 'false' if $r eq 'SCALAR';
    return '[' . join(',', map { json_out($_) } @$v) . ']' if $r eq 'ARRAY';
    return '{' . join(',', map { json_out($_) . ':' . json_out($v->{$_}) } sort keys %$v) . '}' if $r eq 'HASH';
    (my $t = $v) =~ s/(["\\])/\\$1/g;
    $t =~ s/\n/\\n/g;
    $t =~ s/\t/\\t/g;
    $t =~ s/([\x00-\x1f])/sprintf('\\u%04x', ord $1)/ge;
    return qq("$t");
}
sub json_in {
    my ($t) = @_;
    my $at = 0;
    my $ws = sub { $at++ while $at < length $t && substr($t, $at, 1) =~ /\s/ };
    my $value;
    $value = sub {
        $ws->();
        my $c = substr($t, $at, 1);
        if ($c eq '{') {
            $at++; my %h; $ws->();
            if (substr($t, $at, 1) eq '}') { $at++; return \%h }
            while (1) {
                my $k = $value->();
                die "a key is a string\n" if ref $k;
                $ws->(); die "':' expected\n" unless substr($t, $at++, 1) eq ':';
                $h{$k} = $value->();
                $ws->(); my $n = substr($t, $at++, 1);
                return \%h if $n eq '}';
                die "',' or '}' expected\n" unless $n eq ',';
            }
        }
        if ($c eq '[') {
            $at++; my @a; $ws->();
            if (substr($t, $at, 1) eq ']') { $at++; return \@a }
            while (1) {
                push @a, $value->();
                $ws->(); my $n = substr($t, $at++, 1);
                return \@a if $n eq ']';
                die "',' or ']' expected\n" unless $n eq ',';
            }
        }
        if ($c eq '"') {
            $at++; my $s = '';
            while (1) {
                die "a string not closed\n" if $at >= length $t;
                my $ch = substr($t, $at++, 1);
                return $s if $ch eq '"';
                if ($ch eq '\\') {
                    my $e = substr($t, $at++, 1);
                    if ($e eq 'u') {
                        my $code = hex substr($t, $at, 4); $at += 4;
                        if ($code >= 0xD800 && $code < 0xDC00 && substr($t, $at, 2) eq '\\u') { # a pair of surrogates: one character
                            my $low = hex substr($t, $at + 2, 4); $at += 6;
                            $code = 0x10000 + (($code - 0xD800) << 10) + ($low - 0xDC00);
                        }
                        $s .= chr $code;
                    } else { $s .= { n => "\n", t => "\t", r => "\r", b => "\b", f => "\f" }->{$e} // $e }
                } else { $s .= $ch }
            }
        }
        if (substr($t, $at) =~ /^(-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?)/) { $at += length $1; return $1 + 0 }
        if (substr($t, $at, 4) eq 'true') { $at += 4; return 1 }
        if (substr($t, $at, 5) eq 'false') { $at += 5; return 0 }
        if (substr($t, $at, 4) eq 'null') { $at += 4; return undef }
        die "not JSON at $at\n";
    };
    my $v = $value->();
    $ws->();
    die "more after the JSON\n" if $at < length $t;
    return $v;
}

# a span of seconds as nft writes it, cut to seconds: 1m3s
sub nft_span {
    my ($s) = @_;
    return '0s' unless $s;
    my $t = '';
    for ([86400, 'd'], [3600, 'h'], [60, 'm']) { if ($s >= $_->[0]) { $t .= int($s / $_->[0]) . $_->[1]; $s %= $_->[0] } }
    return $t . ($s ? "${s}s" : '') || '0s';
}

# what it does now: as `state status` and `state address` of a router
sub api_state {
    my $table = `nft list table ip adhoc_relay 2>/dev/null`;
    my %st = (running => \($? == 0 ? 1 : 0));
    my ($addr) = address();
    $st{address} = $addr if defined $addr;
    my $udp = IO::Socket::INET->new(Proto => 'udp', PeerAddr => '1.1.1.1', PeerPort => 53);
    my $local = $udp ? $udp->sockhost : undef;
    $st{wan} = $local if defined $local && !public($local);
    return \%st unless ${$st{running}};
    $st{giving} = \(giving() ? 1 : 0);
    my $s = sets($table);
    my $set = sub { @{$s->{$_[0]} // []} };
    my %owner = map { $_->{key}[0] => $_->{key}[1] } $set->('holder');
    my %holds = map { ("$_->{key}[0] $_->{key}[1]" => 1) } $set->('holder');
    my %open = map { $_->{key}[0] => 1 } $set->('open');
    my %dials;
    for ($set->('seen')) { $dials{$_->{key}[0]} //= "$_->{key}[1]:$_->{key}[2]" }
    $st{ports} = [map {
        my $p = $_->{key}[0];
        my $state = !$open{$p} ? 'held' : $dials{$p} ? 'dialing' : 'open';
        { port => N($p), free => nft_span($_->{left}), state => $state, (defined $owner{$p} ? (a => $owner{$p}) : ()),
          ($state eq 'dialing' ? (dials => $dials{$p}) : ()) }
    } sort { $a->{key}[0] <=> $b->{key}[0] } $set->('given')];
    # how many ports are given in all: as a router answers, whose list has the first 1000
    $st{ports_all} = N(scalar @{$st{ports}});
    $st{blocked} = [(map { { address => $_->{key}[0], ends => nft_span($_->{left}) } } $set->('blocked')),
                    (map { { address => $_->{key}[0], ends => nft_span($_->{left}), port => N($_->{key}[1]) } } $set->('guessing'))];
    # how many are blocked in all: the list has the first 100 - a flood of wrong knocks blocks thousands
    $st{blocked_all} = N(scalar @{$st{blocked}});
    # the offloading of the firewall of a router, which carries the meetings of users past their count: a Linux computer has none
    $st{offloading} = \(0);
    $st{flow_offloading} = \(0);
    splice @{$st{blocked}}, 100 if @{$st{blocked}} > 100;
    my @m;
    my %names = user_names();
    if (open my $f, '<', '/proc/net/nf_conntrack') {
        while (<$f>) {
            next unless / tcp / && /mark=(\d+)/ && ($1 & 0x08000000);
            my ($mark, $user) = ($1, $names{($1 >> 16) & 255});
            my @w = split;
            my (@src, @sport, @dport, $bytes);
            for (@w) {
                my ($k, $v) = split /=/, $_, 2;
                next unless defined $v;
                push @src, $v if $k eq 'src';
                push @sport, $v if $k eq 'sport';
                push @dport, $v if $k eq 'dport';
                $bytes += $v if $k eq 'bytes';
            }
            my ($c, $v) = $mark & 0x02000000 ? (1, 0) : (0, 1);
            push @m, { port => N($dport[0]), b => "$src[$c]:$sport[$c]", a => "$src[$v]:$sport[$v]", state => ct_state(\@w), (defined $bytes ? (bytes => N($bytes)) : ()),
                (defined $user ? (user => $user) : ()) };
        }
        close $f;
    }
    # the ports: when each was used last - its newest meeting of the last day, of the set met -, the client, the user when the
    # meeting was of one; and the user of the side that waits at each port given, of the maps port_user0 and port_user1. The number of a user is bits
    # 16-23 of a mark
    my %u;
    for ($set->('met')) {
        my ($p, $ip, $sp, $mark) = @{$_->{key}};
        my $ago = 86400 - ($_->{left} // 0);
        next if exists $u{$p} && $u{$p}{ago} <= $ago;
        $u{$p} = { port => $p, ago => $ago, from => "$ip:$sp", user => $names{(hex($mark // 0) >> 16) & 255} };
    }
    $st{used} = [map { { port => N($_->{port}), ago => N($_->{ago}), from => $_->{from}, (defined $_->{user} ? (user => $_->{user}) : ()) } }
        sort { $a->{port} <=> $b->{port} } values %u];
    my @marked;
    for my $map ($table =~ /map port_user[01] \{.*?elements = \{([^}]*)\}/gs) {
        for (split /,/, $map) {
            next unless /(\d+)\b.*:\s*(0x[0-9a-f]+)/;
            my $n = $names{(hex($2) >> 16) & 255};
            push @marked, { port => N($1), user => $n } if defined $n;
        }
    }
    $st{marked} = \@marked;

    # the users of ports that have a limit: the kilobytes their meetings carried, and their limit in megabytes
    my ($kb, $limit) = counted();
    my %named = map { $_->{key} => $_->{name} } users();
    $st{users} = [map { { key => $_, name => ($named{$_} || '-'), kbytes => N($kb->{$_}),
        (defined $limit->{$_} ? (limit => N($limit->{$_})) : ()) } } sort keys %$kb];
    $st{meetings} = \@m;
    $st{meetings_all} = N(scalar @m);
    my %blocked = map { $_->{key}[0] => 1 } $set->('blocked');
    my %guessing = map { ("$_->{key}[0] $_->{key}[1]" => 1) } $set->('guessing');
    my @tries;
    for my $kind (qw(t_asked t_knocked t_refused t_dialed t_wrote t_read t_called)) {
        for ($set->($kind)) {
            my ($a, $sport, $port) = @{$_->{key}};
            my $what = $kind eq 't_asked' ? 'request' : $kind eq 't_wrote' ? 'wrote' : $kind eq 't_read' ? 'read' : $kind eq 't_called' ? 'call'
                : $kind eq 't_knocked' ? 'knock'
                : $kind eq 't_refused' ? ($blocked{$a} ? 'blocked' : 'wrong')
                : $holds{"$port $a"} ? 'dial-a' : $guessing{"$a $port"} ? 'guessing' : 'dial';
            push @tries, { ago => N(600 - ($_->{left} // 600)), from => "$a:$sport", port => N($port), what => $what };
        }
    }
    @tries = sort { ${$a->{ago}} <=> ${$b->{ago}} } @tries;
    # the log is turned on: off, nothing is noted, and the tries are none
    $st{log} = \($conf{LOG} ? 1 : 0);
    $st{tries_all} = N(scalar @tries);
    $st{tries} = [@tries[0 .. (@tries > 30 ? 29 : $#tries)]];
    my $now = time;
    my %kept = kept_records();
    $st{records} = [map { my $k = $kept{$_}; { name => $_, address => $k->[0], ago => N(max0($now - $k->[1])) } } sort keys %kept];
    my %sent = sent_reports();
    $st{reports} = [map { my $r = $sent{$_};
        { to => $_, ($r->{sent} ? (sent => N(max0($now - $r->{sent}))) : ()), ($r->{answered} ? (answered => N(max0($now - $r->{answered}))) : ()),
          (defined $r->{seen} && $r->{seen} ne '-' ? (seen => $r->{seen}) : ()) } } sort keys %sent];
    return \%st;
}
sub max0 { $_[0] > 0 ? $_[0] : 0 }

sub api_release {
    open my $f, '<', '/usr/share/adhoc-relay/version' or return undef;
    my $v = <$f> // '';
    close $f;
    $v =~ s/\s+//g;
    return $v eq '' ? undef : $v;
}

sub api_get {
    return {
        api => N(1),
        system => 'linux',
        release => api_release(),
        settings => {
            enabled => \(1), password => $conf{PASSWORD} // '',
            (map { lc($_) => N($conf{$_} // 0) } qw(FIRST LAST WAIT TRIES BLOCK SHORT GUESSES CONNECTIONS KNOCK DIAL REBIND)),
            guard => \(($conf{GUARD} // 1) ? 1 : 0), log => \(($conf{LOG} // 0) ? 1 : 0), address => $conf{ADDRESS} // '',
        },
        fixed => [map { { port => N($_->{port}), key => $_->{key}, name => $_->{name} // '' } } fixed()],
        records => [map { { name => $_->{name}, write => $_->{write}, read => [@{$_->{reads}}] } } records()],
        reports => [map { pretty(plain($_->{raw})) } reports()],
        users => [map { { name => $_->{name}, key => $_->{key}, of => $_->{of}, expires => $_->{expires}, limit => N($_->{limit}), direct => \($_->{direct} ? 1 : 0), tags => [map { N($_) } @{$_->{tags}}] } } users()],
        tags => [map { { id => N($_->{id}), name => $_->{name} } } tags()],
        state => api_state(),
    };
}

sub api_fail { print json_out({ error => $_[0] }), "\n"; exit 1 }

# What is given, merged into what there is and checked as `rules load` checks it: the list of what is wrong
sub api_check {
    my ($w) = @_;
    my $s = $w->{settings};
    my @bad;
    # a whole number written as it is kept: no zeros in front - nft takes those for a number of base 8 -, nothing after it; \z, not
    # $, in every check here: a line break at the end of a value would cut its line of the settings in two
    my $int = sub { defined $_[0] && !ref $_[0] && $_[0] =~ /\A(?:0|[1-9]\d*)\z/ && $_[0] >= $_[1] && $_[0] <= $_[2] };
    push @bad, 'settings.enabled: a Linux computer runs AdHoc Relay as its service - systemctl stop adhoc-relay stops it' unless $s->{enabled};
    push @bad, 'settings.password: 16 letters and digits' unless ($s->{password} // '') =~ /\A[A-Za-z0-9]{16}\z/;
    push @bad, 'settings.first, settings.last: ports, the first below the last'
        unless $int->($s->{first}, 1, 65534) && $int->($s->{last}, ($s->{first} // 0) + 1, 65535);
    # as `adhoc-relay set` takes them: a time of 0 never ends for nft, and no try at all loads no rules
    my %low = (wait => 30, tries => 1, block => 1, short => 1, guesses => 1);
    my %high = (wait => 86400, tries => 1000, block => 86400, short => 3600, guesses => 1000);
    $int->($s->{$_}, $low{$_}, $high{$_}) or push @bad, "settings.$_: a whole number of $low{$_}-$high{$_}" for qw(wait tries block short guesses);
    $int->($s->{connections}, 0, 1000) or push @bad, 'settings.connections: a whole number of 0-1000, 0 - any number';
    # a knock may come a few seconds late, and the port must stay open till the next; a try of dialing of other seconds would
    # leave a longer time between two SYNs than the rules wait
    if (!$int->($s->{knock}, 5, 120)) { push @bad, 'settings.knock: a whole number of 5-120 seconds' }
    elsif ($int->($s->{wait}, 30, 86400) && $s->{wait} < $s->{knock} + 10) { push @bad, 'settings.wait: 10 seconds more than settings.knock at least' }
    push @bad, 'settings.dial: 3, 7, 15 or 31 seconds' unless defined $s->{dial} && !ref $s->{dial} && $s->{dial} =~ /\A(?:3|7|15|31)\z/;
    $int->($s->{rebind}, 1, 60) or push @bad, 'settings.rebind: a whole number of 1-60 minutes';
    push @bad, 'settings.address: a name in DNS, an IPv4 address, or empty - found'
        unless ($s->{address} // '') eq '' || $s->{address} =~ /\A[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?\z/;
    my (%used, %ports, %names);
    my $key = sub {
        my ($k, $where) = @_;
        if (($k // '') !~ /\A[A-Za-z0-9]{16}\z/) { push @bad, "$where: 16 letters and digits" }
        elsif ($used{$k}) { push @bad, "$where: the same key as $used{$k}" }
        else { $used{$k} = $where }
    };
    $used{$s->{password}} = 'settings.password' if ($s->{password} // '') =~ /\A[A-Za-z0-9]{16}\z/;
    my $i = 0;
    for my $f (@{$w->{fixed}}) {
        my $where = 'fixed[' . $i++ . ']';
        if (!$int->($f->{port}, ($s->{first} // 0) + 1, $s->{last} // 0)) { push @bad, "$where.port: a port of " . (($s->{first} // 0) + 1) . "-" . ($s->{last} // 0) }
        elsif ($ports{$f->{port}}++) { push @bad, "$where.port: fixed twice" }
        $key->($f->{key}, "$where.key");
        push @bad, "$where.name: letters, digits, - and _" if ($f->{name} // '') ne '' && $f->{name} !~ /\A[A-Za-z0-9_-]+\z/;
    }
    $i = 0;
    for my $r (@{$w->{records}}) {
        my $where = 'records[' . $i++ . ']';
        if (($r->{name} // '') !~ /\A[A-Za-z0-9_-]+\z/) { push @bad, "$where.name: letters, digits, - and _" }
        elsif ($names{$r->{name}}++) { push @bad, "$where.name: kept twice" }
        $key->($r->{write}, "$where.write");
        if (ref $r->{read} ne 'ARRAY') { push @bad, "$where.read: a list of read keys" }
        else { my $j = 0; $key->($_, "$where.read[" . $j++ . ']') for @{$r->{read}} }
    }
    $i = 0;
    for my $t (@{$w->{reports}}) {
        my $where = 'reports[' . $i++ . ']';
        push @bad, "$where: not ✏️<write key>👀<read key>👉<relay>:<port>" unless report_of($t // '');
    }
    $i = 0;
    for my $a (@{$w->{users}}) {
        my $where = 'users[' . $i++ . ']';
        my $of = $a->{of} // '';
        if ($of =~ /\A\d+\z/) { push @bad, "$where.of: no fixed port $of" unless $ports{$of} }
        elsif ($of =~ /\A@(.+)\z/s) { push @bad, "$where.of: no record $1" unless $names{$1} }
        elsif ($of ne 'password') { push @bad, "$where.of: password, a fixed port, or \@record" }
        $key->($a->{key}, "$where.key");
        push @bad, "$where.expires: YYYY-MM-DD, its last day, a day there is, or empty - never" unless ($a->{expires} // '') eq '' || day_ok($a->{expires});
        push @bad, "$where.limit: megabytes, 1000000000 at most, 0 - none" unless $int->($a->{limit} // 0, 0, 1e9);
        push @bad, "$where.direct: true - the direct path only, or false" if ref $a->{direct} || ($a->{direct} // 0) !~ /\A[01]\z/;
        push @bad, "$where.name: letters, digits, - and _" if ($a->{name} // '') ne '' && $a->{name} !~ /\A[A-Za-z0-9_-]+\z/;
        push @bad, "$where.tags: 8 numbers of 0-255 at most"
            unless ref($a->{tags} // []) eq 'ARRAY' && @{$a->{tags} // []} <= 8 && !grep { !$int->($_, 0, 255) } @{$a->{tags} // []};
    }
    # a user of a port has a number of 1-255: one more would be left out by the rules, and open nothing
    push @bad, 'users: 255 users of ports at most - of the password and of fixed ports' if (grep { ($_->{of} // '') !~ /\A@/ } @{$w->{users}}) > 255;
    $i = 0;
    my (%ids, %tagged);
    for my $t (@{$w->{tags} // []}) {
        my $where = 'tags[' . $i++ . ']';
        push @bad, "$where.id: a number of 0-255, once" unless $int->($t->{id}, 0, 255) && !$ids{$t->{id}}++;
        push @bad, "$where.name: letters, digits, - and _, once" unless ($t->{name} // '') =~ /\A[A-Za-z0-9_-]+\z/ && !$tagged{$t->{name}}++;
    }
    return @bad;
}

# a day of the calendar, YYYY-MM-DD: `rules` leaves out a user of a day there is not, and says so in the log only
sub day_ok {
    my ($y, $m, $d) = ($_[0] // '') =~ /\A(\d{4})-(\d\d)-(\d\d)\z/ or return 0;
    my @days = (31, $y % 4 == 0 && ($y % 100 || $y % 400 == 0) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31);
    return $m >= 1 && $m <= 12 && $d >= 1 && $d <= $days[$m - 1];
}

# `adhoc-relay api users [any] <tags>`: the users with each of the tags - or one of them -, and what their meetings carried
sub api_users {
    my ($sel) = @_ ? with_tags('with', @_) : ();
    my ($kb) = counted();
    return [map { { name => $_->{name}, key => $_->{key}, of => $_->{of}, expires => $_->{expires}, limit => N($_->{limit}),
        direct => \($_->{direct} ? 1 : 0), tags => [map { N($_) } @{$_->{tags}}], kbytes => N($kb->{$_->{key}} // 0) } } $sel ? users_with(@$sel) : users()];
}

sub api_set {
    my $text = do { local $/; <STDIN> } // '';
    utf8::decode($text);
    my $given = eval { json_in($text) };
    api_fail('the input is not JSON: ' . ($@ =~ s/\s+$//r)) unless defined $given;
    api_fail('the input is not a JSON object') unless ref $given eq 'HASH';
    # each part as it must be, before anything of it is looked into: a wrong one is an answer, not a fall
    api_fail('settings: an object') if exists $given->{settings} && ref $given->{settings} ne 'HASH';
    for my $part (qw(fixed records reports users tags)) {
        next unless exists $given->{$part};
        api_fail("$part: a list") if ref $given->{$part} ne 'ARRAY';
        api_fail($part eq 'reports' ? 'reports: a list of lines' : "$part: a list of objects")
            if grep { $part eq 'reports' ? !defined($_) || ref($_) : ref($_) ne 'HASH' } @{$given->{$part}};
    }
    my $now = api_get();
    my %settings = map { my $v = $now->{settings}{$_}; ($_ => ref $v eq 'N' ? $$v : ref $v eq 'SCALAR' ? $$v : $v) } keys %{$now->{settings}};
    my $plainly = sub { [map { my %x = %$_; $x{port} = ${$x{port}} if ref $x{port}; \%x } @{$_[0]}] };
    my %want = (
        settings => { %settings, %{$given->{settings} // {}} },
        fixed => $given->{fixed} // $plainly->($now->{fixed}),
        records => $given->{records} // $now->{records},
        reports => $given->{reports} // $now->{reports},
        users => $given->{users} // [map { my %x = %$_; $x{limit} = ${$x{limit}} if ref $x{limit}; $x{direct} = ${$x{direct}} if ref $x{direct}; $x{tags} = [map { ref $_ ? $$_ : $_ } @{$x{tags}}]; \%x } @{$now->{users}}],
        tags => $given->{tags} // [map { { id => ${$_->{id}}, name => $_->{name} } } @{$now->{tags}}],
    );
    api_fail('fixed, records, reports, users, tags: each a list') if grep { ref $want{$_} ne 'ARRAY' } qw(fixed records reports users tags);
    my @bad = api_check(\%want);
    api_fail(join '; ', @bad) if @bad;
    my $s = $want{settings};
    set(uc $_, $s->{$_}) for qw(password first last wait tries block short guesses connections knock dial rebind);
    set('GUARD', $s->{guard} ? 1 : 0);
    set('LOG', $s->{log} ? 1 : 0);
    set('ADDRESS', $s->{address} // '');
    # a part not given stays as its line is: an entry of it written by hand, not understood here, is not lost with a set of another
    set('FIXED', join ' ', map { "$_->{port}:$_->{key}" . (($_->{name} // '') ne '' ? ":$_->{name}" : '') } @{$want{fixed}}) if exists $given->{fixed};
    set('RECORDS', join ' ', map { "$_->{name}:$_->{write}:" . join(',', @{$_->{read}}) } @{$want{records}}) if exists $given->{records};
    set('REPORTS', join ' ', map { pretty(plain($_)) } @{$want{reports}}) if exists $given->{reports};
    set('USERS', join ' ', map { user_entry({ %$_, limit => $_->{limit} // 0 }) } @{$want{users}}) if exists $given->{users};
    set('TAGS', join ' ', map { "$_->{id}:$_->{name}" } @{$want{tags}}) if exists $given->{tags};
    save();
    # loaded as `adhoc-relay` loads them: a reload, the meetings going on go on. What does not load is not kept: the settings of
    # before come back - nothing written, as the answer says
    my $failed;
    if (systemd()) {
        my $how = system('systemctl', 'is-active', '--quiet', 'adhoc-relay') == 0 ? 'reload' : 'restart';
        $failed = "systemctl $how adhoc-relay failed - see systemctl status adhoc-relay" if system('systemctl', $how, 'adhoc-relay') != 0;
    } else {
        $failed = "no systemd here - $LOAD" if system('sh', '-c', $LOAD) != 0;
    }
    if ($failed) {
        @text = @loaded;
        save();
        api_fail("not saved: the rules do not load with it: $failed");
    }
    load();
    @address = ();
    print json_out(api_get()), "\n";
}

sub api {
    my ($what, @rest) = @_;
    if (($what // '') eq 'get') { print json_out(api_get()), "\n"; return }
    if (($what // '') eq 'set') { api_set(); return }
    if (($what // '') eq 'users') { print json_out(api_users(@rest)), "\n"; return }
    print STDERR "usage: adhoc-relay api get | set ( JSON on the standard input ) | users [any] <tag>[,<tag>...]\n";
    exit 2;
}

my $cmd = shift(@ARGV) // (-t STDIN && -t STDOUT ? 'menu' : 'status');
if ($cmd =~ /^(help|-h|--help)$/) { help(); exit 0 }
fail('As root: sudo adhoc-relay ' . join(' ', $cmd eq 'menu' ? () : $cmd, @ARGV)) if $> != 0;
load();
if ($cmd eq 'menu') { menu(); exit 0 }
elsif ($cmd eq 'api') { binmode STDOUT, ':utf8'; api(@ARGV); exit 0 }
elsif ($cmd eq 'status') { print "\n"; header(); password_note(); status() }
elsif ($cmd eq 'settings') { settings_show() }
elsif ($cmd eq 'set') { set_cmd(@ARGV) }
elsif ($cmd eq 'lines') { lines() }
elsif ($cmd eq 'password') { password(@ARGV) }
elsif ($cmd eq 'fixed') { fixed_cmd(@ARGV) }
elsif ($cmd eq 'record') { record_cmd(@ARGV) }
elsif ($cmd eq 'report') { report_cmd(@ARGV) }
elsif ($cmd eq 'address') { address_cmd(@ARGV) }
elsif ($cmd eq 'user') { user_cmd(@ARGV) }
elsif ($cmd eq 'tag') { tag_cmd(@ARGV) }
elsif ($cmd eq 'log') { log_cmd(@ARGV) }
elsif ($cmd eq 'unblock') { unblock_cmd(@ARGV) }
else { help(); exit 2 }
print "\n";
