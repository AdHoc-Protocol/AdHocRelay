#!/bin/sh
# The packages of OpenWrt AdHoc Relay needs: the modules of ucode `give` and public.uc import - socket is not in OpenWrt, math is not
# in its snapshots -, and the flowtables of the kernel for the fast path, which firewall4 brings - not a must.
#   needs           the modules missing, spaces between; nothing - none: `give` can run
#   needs install   installs what is missing now: 0 - the modules are there
#   needs wait      installs them once the router reaches the packages of OpenWrt - again a minute after, an hour at most - and starts
#                   AdHoc Relay again. The service runs it when a module is missing: right after the archive of the page of LuCI is
#                   restored, or a firmware is flashed, the router starts before its network
MODULES='socket uci math fs'

missing() {
	for m in $MODULES; do
		[ -f "/usr/lib/ucode/$m.so" ] || printf 'ucode-mod-%s ' "$m"
	done
}

fetch() {
	need=$(missing)
	[ -n "$(find /lib/modules -name 'nf_flow_table.ko' 2>/dev/null | head -n 1)" ] || need="$need kmod-nft-offload"
	[ -n "$(echo $need)" ] || return 0
	# a feed that failed to update leaves the others: the packages may be in them
	if command -v apk >/dev/null; then
		apk update >/dev/null 2>&1
		apk add $need >/dev/null 2>&1
	else
		opkg update >/dev/null 2>&1
		opkg install $need >/dev/null 2>&1
	fi
	[ -z "$(missing)" ]
}

case "$1" in
'')
	missing
	;;
install)
	fetch
	;;
wait)
	n=0
	while [ "$n" -lt 60 ]; do
		if fetch; then
			logger -t adhoc-relay "the packages it needs are installed: AdHoc Relay starts"
			/etc/init.d/adhoc-relay restart
			exit 0
		fi
		n=$((n + 1))
		sleep 60
	done
	logger -t adhoc-relay "the packages $(missing)did not install in an hour: the router reaches no packages of OpenWrt. Services > AdHoc Relay, or a restart, tries again"
	exit 1
	;;
*)
	echo "usage: needs [install | wait]" >&2
	exit 2
	;;
esac
