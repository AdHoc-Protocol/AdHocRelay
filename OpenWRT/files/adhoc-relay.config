config adhoc-relay 'main'
	option enabled '1'
	# 16 characters: the request for a port and the knock that opens it start with it; install.sh makes one when it is empty
	option password ''
	# the range: the first port answers the requests for a port, the others are the ports of meeting it gives
	option first '40000'
	option last '49999'
	# seconds a port of meeting stays open after the last knock or try of its first side
	option wait '60'
	# The times of the servers - the relay tells them in its answer to their bind. `knock`: how often a server knocks, seconds; its
	# NAT must keep the mapping of a knock till the next one, most keep it 30 s or more; `wait` must be 10 s more at least.
	# `dial`: how long a try of dialing of a server is, seconds - 3, 7, 15 or 31; its system sends the SYN again within it, after
	# 1, 3, 7 and 15 s, and the router looks at each SYN: a longer try, fewer SYNs. A server started again on the same port behind
	# a NAT that keeps no port takes it back in about half that time. `rebind`: how often a server binds again, minutes; each
	# bind is work for `give`, as much as a few hundred SYNs; the key of its knocks lives two times that
	option knock '20'
	option dial '31'
	option rebind '30'
	# wrong knocks an address may make; one more comes back each minute
	option tries '5'
	# seconds an address that knocked wrong too often is blocked, or guessed at a port too often
	option block '600'
	# the guard against guessing passwords: a meeting that ends within `short` seconds is short - a password tried and refused -;
	# more than `guesses` short meetings of an address at a port, one more back each 10 minutes, and that address is blocked at
	# that port. 0: off, for a server whose meetings are short by nature
	option guard '1'
	option short '20'
	option guesses '5'
	# the connections one address may have through the router at once: one more meets nobody until one of them ends. 0: any
	# number, nothing is counted. Several people behind one public address - an office, a mobile network - are one address
	option connections '0'
	# the log: what came in the last 10 minutes - requests, knocks, connections - is noted for the page. Each note is work for the
	# router; 1 turns it on, for finding out why something does not work, and the page turns it on and off
	option log '0'
	# a name of this router in DNS, when its owner keeps one: the line the page copies for the server has it then, not the public
	# address. Only the owner knows it: the router cannot tell whether a name is kept, nor how
	option dns ''

# A fixed port: always the same, for one key. Its server knocks the key alone at it, asks nothing; its line is <key>👉<address>:<port>
#config fixed
#	option name 'office-rdp'
#	option port '41000'
#	option key 'Fx2pL8wNq7Rk3mZa'

# A record: this router keeps the address of a relay whose address changes. That one writes it with the write key, the
# servers read it with a read key
#config record
#	option name 'dacha'
#	option write 'Wk3vB9xQm5Tz2Lpe'
#	list read 'Rk8mP2qLx3Vb7NtY'

# A user: a key of 16 the owner gives to someone in place of the password, of the key of a fixed port, or of a read key of a
# record - `of`: password, the port, @<the name of the record>. It works as that key works until `expires`, its last day
# ( YYYY-MM-DD; empty - always ). Its meetings may carry `limit` megabytes through this router ( empty - no limit ): a limit is
# work for the router, it counts every packet of them; without one nothing is counted. With `direct` 1 its clients reach its server only by the direct path, a call: a meeting through this router is
# refused, and nothing is carried. Its tags, 8 at most, numbers of 0-255, group the users: the page and `adhoc-relay api users`
# choose by them
#config user
#	option name 'partner'
#	option key 'Aq7mL2xR9pTz4WkN'
#	option of 'password'
#	option expires '2026-12-31'
#	option limit '10240'
#	list tags '3'
#	list tags '17'

# The name of a tag, for people: the users keep the number
#config tag
#	option id '17'
#	option name 'guests'

# A report: the address of this router changes - it writes it into a record of a relay of a fixed address, every 20 s
# and at once when it changes. `to` is the line that one copies for it: ✏️<write key>👀<read key>👉<its address>:<its first port>.
# Every line of this router reads its address there then: the ports are in the lines
#config report
#	option to '✏️Wk3vB9xQm5Tz2Lpe👀Rk8mP2qLx3Vb7NtY👉203.0.113.7:40000'
