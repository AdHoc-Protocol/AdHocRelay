#!/bin/sh
# What this router is now, as JSON: the page of LuCI ( rpcd ) and `adhoc-relay api get` take it from here alike.
# `state address` - the public address of this router, for the line of the server: `address`, that of its wan when it is public,
# else the one the internet sees it at ( public.uc, STUN ) - then `wan` is the address of its wan too: something in front of the
# router, another router or the NAT of the provider, must forward the range to it.
# `state status` - what it does now:
#   running   the rules are loaded
#   failed    the last load of the rules failed, and why: the settings there are are not applied - the rules of before run on,
#             or none
#   giving    `give` runs: servers get ports
#   missing   the packages of OpenWrt it needs and waits for, when there are: they come once the router reaches them
#   ports     the ports given: the port, the address of the server - the last that knocked with the id the port is given to - its state - held ( closed ), open, or open and
#             A dials it ( from where ) - and when it is free again unless A knocks
#   meetings  the connections that met: the port, the client, the server, the state, the bytes when the kernel counts them
#   blocked   the addresses blocked for wrong requests or knocks, and those blocked at a port for guessing passwords there - `port`
#             -, and when the block ends
#   tries     what came in the last 10 minutes, the newest first, 30 at most: seconds ago, from - address and source port - the
#             port of the range, and what - request ( a bind ), knock ( with the key of the knocks of the port ), wrong ( a
#             request with the id of no key, or other bytes at a port ), blocked ( the address is blocked ), dial-a ( a SYN of an
#             address that knocked ),
#             dial ( a SYN of another ), guessing ( a SYN of an address blocked at that port for guessing ), wrote ( a meeting
#             point of a changing address wrote its address ), read ( a server read an address ), call ( a client called a
#             server, to meet it directly ); `tries_all` - how many there are in all. Noted only while the log is turned on
#   log       the log of the last 10 minutes is turned on: its rules are loaded. Off, `tries` is empty
#   records   the addresses relays of changing addresses wrote here, as `give` keeps them: the name of the record, the
#             address, seconds since the last write
#   reports   the relays this router writes its own address to: where, seconds since the last write and since the last
#             answer - none, never - and the address of this router as that relay saw it
# A time to the end of something - `free`, `ends` - is as nft writes it, cut to seconds: 1m3s.
# `state status asked` - the same, for the page: what it asks for is JSON on the standard input, { "meetings": false, "tries":
# false } - what it does not show now is not made, and its key is not in the answer. The meetings are asked for on the tab
# Ports alone, and so are the ports one by one and when they were used: without them, "ports", "used" and "marked" are not in
# the answer - "ports_all" is. The costly parts: every connection the router knows is read for the meetings, the whole table of
# conntrack; with thousands of servers, the sets of who holds each port, which is open, where its side dials from, for the
# ports; the tries are a pass of the table and a sort more.

. /usr/share/libubox/jshn.sh

# what `give` keeps of the records and the reports, rewritten as they change
STATE=/tmp/adhoc-relay

# The sets of the table as nft lists it, in one pass, as JSON: "ports" - each port given: its port, `free` - how long till it is
# free, `a` - its server, `state` - held, open or dialing, `dials` - from where -, and "blocked" - each address blocked: `address`,
# `ends`, `port` when it is blocked at a port: it guessed passwords there. What `expires` says is cut to seconds: "52s880ms" ->
# "52s". A line of the listing holds whole elements: each line is taken as it comes, nothing gathered. Of the ports the first
# 1000, of the blocked the first 100, and how many there are of each: "ports_all", "blocked_all". $1 - 0: the ports counted
# alone, "ports" not made
# The JSON of the lists is written by awk, a line an element: the functions of the shell for JSON take a time that grows with the
# square of what they hold - a second for a thousand ports, on a computer far faster than a router
sets() {
	awk -v detail="$1" '
		function q(t) { gsub(/\\/, "\\\\", t); gsub(/"/, "\\\"", t); return "\"" t "\"" }
		# what `expires` says of an element, cut to seconds - "52s880ms" -> "52s" -, by no pattern; "-" when it says nothing
		function left(e,    c) {
			c = index(e, " expires ")
			if (!c) return "-"
			e = substr(e, c + 9)
			c = index(e, " ")
			if (c) e = substr(e, 1, c - 1)
			if (substr(e, length(e) - 1) == "ms") {
				e = substr(e, 1, length(e) - 2)
				while (e != "" && index("0123456789", substr(e, length(e)))) e = substr(e, 1, length(e) - 1)
			}
			return e == "" ? "0s" : e
		}
		function one(e,    m, w) {
			# Only what will be shown is taken apart: the ports past the first 1000 and the blocked past the first 100 are
			# counted, no more; of who holds a port, where its side dials from, whether it is open - those of the ports
			# shown, known by the number an element begins with. A port given is its number and its time: no word taken apart
			if (name == "given") {
				if (e + 0) { if (++pg <= 1000 && detail) { port[pg] = e + 0; free[pg] = left(e); shown[e + 0] = 1 } }
				return
			}
			if (name == "blocked" || name == "guessing") { if (pb >= 100) { if (e + 0) pb++; return } }
			else if (!((e + 0) in shown)) return
			m = split(e, w, " ")
			if (m == 0) return
			if (name == "holder") owner[w[1]] = w[3] # port . address
			else if (name == "open") opened[w[1]] = 1
			else if (name == "seen") { if (!(w[1] in a)) a[w[1]] = w[3] ":" w[5] } # port . address . source port
			else if (name == "blocked") { pb++; address[pb] = w[1]; ends[pb] = left(e); at[pb] = "-" }
			else if (name == "guessing") { pb++; address[pb] = w[1]; ends[pb] = left(e); at[pb] = w[3] } # address . port
		}
		# The lines of elements are most of what is read, thousands with thousands of servers, and the awk of a router is slow
		# with them: a line of one element - nft writes each with a time on a line of its own - is taken whole, not split; no
		# pattern looks at it
		on {
			line = $0
			if (e = index(line, "}")) { line = substr(line, 1, e - 1); on = 0 }
			if (want) {
				e = index(line, ",")
				if (!e || e == length(line)) one(e ? substr(line, 1, e - 1) : line)
				else { n = split(line, it, ","); for (i = 1; i <= n; i++) one(it[i]) }
			}
			next
		}
		$1 == "set" || $1 == "map" || $1 == "chain" {
			name = $1 == "set" ? $2 : ""
			want = (name == "given" || name == "holder" || name == "open" || name == "seen" || name == "blocked" || name == "guessing")
		}
		index($0, "elements = {") {
			on = 1; $0 = substr($0, index($0, "elements = {") + 12)
			if (e = index($0, "}")) { $0 = substr($0, 1, e - 1); on = 0 }
			if (want) { n = split($0, it, ","); for (i = 1; i <= n; i++) one(it[i]) }
		}
		END {
			# what a port says is numbers, addresses and times of nft, and words of here: nothing in it to escape, no q() - two
			# patterns a word, a second of a router for 1000 ports
			if (detail) printf "\"ports\":["
			for (i = 1; detail && i <= pg && i <= 1000; i++) {
				p = port[i]
				state = !(p in opened) ? "held" : (p in a) ? "dialing" : "open"
				printf "%s{\"port\":%d,\"free\":\"%s\"%s,\"state\":\"%s\"%s}", (i > 1 ? "," : ""), p, free[i], ((p in owner) ? ",\"a\":\"" owner[p] "\"" : ""),
					state, (state == "dialing" ? ",\"dials\":\"" a[p] "\"" : "")
			}
			printf "%s\"ports_all\":%d,\"blocked\":[", (detail ? "]," : ""), pg
			for (i = 1; i <= pb && i <= 100; i++)
				printf "%s{\"address\":%s,\"ends\":%s%s}", (i > 1 ? "," : ""), q(address[i]), q(ends[i]), (at[i] != "-" ? ",\"port\":" (at[i] + 0) : "")
			printf "],\"blocked_all\":%d", pb
		}'
}

# the sets t_* of the table, each element a line "<seconds ago> T <address:source port> <port> <what>", in no order: the seconds
# first, as the sort of busybox sorts by the start of a line only. A set of them lives 10 minutes: the time since is 600 s less what
# `expires` says
tries() {
	awk '
		function secs(t,    n, all) {
			all = 0
			while (match(t, /^[0-9]+(ms|d|h|m|s)/)) {
				n = substr(t, 1, RLENGTH); t = substr(t, RLENGTH + 1)
				if (n ~ /ms$/) continue
				all += (n ~ /d$/) ? n * 86400 : (n ~ /h$/) ? n * 3600 : (n ~ /m$/) ? n * 60 : n + 0
			}
			return all
		}
		function items(name, all,    n, it, i, m, w, j, left) {
			n = split(all, it, ",")
			for (i = 1; i <= n; i++) {
				m = split(it[i], w, " ")
				if (m == 0) continue
				left = 0
				for (j = 1; j < m; j++) if (w[j] == "expires") left = secs(w[j + 1])
				if (name == "holder") owner[w[1] " " w[3]] = 1 # port . address
				else if (name == "blocked") blocked[w[1]] = 1
				else if (name == "guessing") guessing[w[1] " " w[3]] = 1 # address . port
				else if (name ~ /^t_/) { t++; kind[t] = name; ago[t] = 600 - left; addr[t] = w[1]; from[t] = w[1] ":" w[3]; port[t] = w[5] } # address . source port . port
			}
		}
		/^[ 	]*(set|map|chain) / {
			name = $1 == "set" ? $2 : ""; on = 0
			want = (name == "holder" || name == "blocked" || name == "guessing" || name ~ /^t_/)
		}
		want && /elements = \{/ { on = 1; sub(/.*elements = \{/, "") }
		on { line = $0; e = index(line, "}"); if (e) { line = substr(line, 1, e - 1); on = 0 } items(name, line) }
		END {
			for (i = 1; i <= t; i++) {
				k = kind[i]; mine = (port[i] " " addr[i]) in owner
				if (k == "t_asked") k = "request"
				else if (k == "t_wrote") k = "wrote"
				else if (k == "t_read") k = "read"
				else if (k == "t_called") k = "call"
				else if (k == "t_knocked") k = "knock"
				else if (k == "t_refused") k = (addr[i] in blocked) ? "blocked" : "wrong"
				else k = mine ? "dial-a" : ((addr[i] " " port[i]) in guessing) ? "guessing" : "dial"
				print ago[i], "T", from[i], port[i], k
			}
		}'
}

address() {
	wan=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
	json_init
	case "$wan" in
	# none, or of a private network, or of the NAT of a provider ( 100.64.0.0/10 ): the internet sees the router otherwise
	''|10.*|127.*|169.254.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*)
		json_add_string address "$(ucode /usr/libexec/adhoc-relay/public.uc 2>/dev/null)"
		[ -n "$wan" ] && json_add_string wan "$wan"
		;;
	*)
		json_add_string address "$wan"
		;;
	esac
	json_dump
}

status() {
	# all of it, unless the page says what it shows now
	meetings_wanted=1 tries_wanted=1
	if [ "$1" = asked ]; then
		json_load "$(cat)" 2>/dev/null && {
			json_get_var one meetings
			json_get_var two tries
			[ "$one" != 0 ] || meetings_wanted=0
			[ "$two" != 0 ] || tries_wanted=0
		}
	fi
	json_init
	# the last load of the rules failed: what is loaded - the rules of before, or none - is not of the settings there are
	[ ! -s "$STATE/failed" ] || json_add_string failed "$(cat "$STATE/failed")"
	# The sets it shows, each by an nft of its own - several in one command an nft of 1.1 takes for a mistake -, into a file of
	# the memory, read from there by the awk of each list - a file for each, as each line costs the awk of a router: the ports
	# ( $table ), the meetings of the day and the users of the ports ( .used ), the quotas ( .users ), the log ( .log ). Not the
	# table whole: with thousands of servers most of it is the keys of their knocks, four maps the page shows nothing of - a
	# listing of all of it took seconds and megabytes of a router, an nft for each set some 20 ms. The first fails when there is
	# no table. The sets of the log only while it is on and the page shows it
	table="$STATE/table.$$"
	mkdir -p "$STATE"
	trap 'rm -f "$table" "$table.used" "$table.users" "$table.log"' EXIT
	if ! (umask 077; nft list set ip adhoc_relay given > "$table" 2>/dev/null); then
		json_add_boolean running 0
		json_dump
		return
	fi
	(
		umask 077
		for s in blocked guessing; do nft list set ip adhoc_relay "$s"; done >> "$table"
		# who holds a port tells the tries of its side from those of others too
		[ "$meetings_wanted$tries_wanted" = 00 ] || for s in holder open seen; do nft list set ip adhoc_relay "$s"; done >> "$table"
		: > "$table.used"
		[ "$meetings_wanted" = 0 ] || { nft list set ip adhoc_relay met; for s in port_user0 port_user1; do nft list map ip adhoc_relay "$s"; done; } > "$table.used"
		{ nft list quotas table ip adhoc_relay; nft list counters table ip adhoc_relay; } > "$table.users"
		: > "$table.log"
		[ "$tries_wanted" = 1 ] && nft list set ip adhoc_relay t_asked > "$table.log" && for s in t_knocked t_refused t_dialed t_wrote t_read t_called; do
			nft list set ip adhoc_relay "$s"
		done >> "$table.log"
	) 2>/dev/null
	json_add_boolean running 1
	if pgrep -f 'adhoc-relay/give.uc' >/dev/null; then
		json_add_boolean giving 1
	else
		json_add_boolean giving 0
		# the packages it needs are being installed: right after an install by the page of LuCI, before the router reaches the
		# internet. `give` runs: they are there, nothing to look for
		missing=$(/usr/libexec/adhoc-relay/needs 2>/dev/null)
		[ -n "$(echo $missing)" ] && json_add_string missing "$(echo $missing)"
	fi

	# the lists that may be long - the ports, the blocked, the meetings, when the ports were used, the tries - as JSON made by awk,
	# put after what the functions of the shell made: `lists`
	lists=$(sets "$meetings_wanted" < "$table")
	# The offloading of the firewall of the router carries every connection it forwards on its own fast path, past these rules:
	# with a user that has a limit - a quota of the table -, what its meetings carry is not counted there, and the limit does not
	# hold. The page says so where the users are
	offloading=0 flow=0
	[ "$(uci -q get firewall.@defaults[0].flow_offloading)" != 1 ] || flow=1
	! grep -q 'quota a_' "$table.users" || offloading=$flow
	json_add_boolean offloading "$offloading"
	# the offloading itself, on or off: the page sets no limit while it is on
	json_add_boolean flow_offloading "$flow"

	if [ "$meetings_wanted" = 1 ]; then
	# the connections of the mark of AdHoc Relay: the original direction is the client to the relay, the reply comes from the server
	# the number of a user in the mark - bits 16-23 - is the name of $STATE/users
	# the first 1000 of them, and how many there are: "meetings_all"
	lists="$lists,$(awk -v names="$STATE/users" '
		function q(t) { gsub(/\\/, "\\\\", t); gsub(/"/, "\\\"", t); return "\"" t "\"" }
		BEGIN { while ((getline l < names) > 0) { split(l, w, " "); name[w[1]] = w[3] }; printf "\"meetings\":[" }
		/ tcp / && match($0, /mark=[0-9]+/) {
			mark = substr($0, RSTART + 5, RLENGTH - 5) + 0
			if (and(mark, 134217728) == 0) next
			n = 0; s = 0; bytes = ""
			for (i = 1; i <= NF; i++) {
				split($i, kv, "=")
				if (kv[1] == "src") { n++; src[n] = kv[2] }
				else if (kv[1] == "sport") sport[n] = kv[2]
				else if (kv[1] == "dport") dport[n] = kv[2]
				else if (kv[1] == "bytes") { s += kv[2]; bytes = s }
			}
			id = and(mark, 16711680) / 65536
			# the client is of the way there - or, met the other way round ( 0x02000000 ), of the way back
			c = and(mark, 33554432) ? 2 : 1; v = 3 - c
			# the state: the sixth word, after the seconds left. A meeting on the fast path of the kernel is written with
			# neither: it is established - only such go there
			st = ($5 ~ /^[0-9]+$/ && $6 ~ /^[A-Z][A-Z_0-9]*$/) ? $6 : ($5 ~ /^[A-Z][A-Z_0-9]*$/) ? $5 : "ESTABLISHED"
			if (++all <= 1000)
				printf "%s{\"port\":%d,\"b\":%s,\"a\":%s,\"state\":%s%s%s}", (all > 1 ? "," : ""), dport[1], q(src[c] ":" sport[c]), q(src[v] ":" sport[v]), q(st),
					(bytes == "" ? "" : sprintf(",\"bytes\":%.0f", bytes)), (id && (id in name) ? ",\"user\":" q(name[id]) : "")
		}
		END { printf "],\"meetings_all\":%d", all }' /proc/net/nf_conntrack 2>/dev/null)"
	fi

	# The ports: when each was used last - its newest meeting of the last day, of the set met -, the client, and the user when
	# the meeting was of one; "U <port> <seconds ago> <client> <user or ->". And the user each port given is marked with now, of
	# the maps port_user0 and port_user1 - the user of the side that waits there: "M <port> <user>". The number of a user is bits 16-23 of a mark, its name in $STATE/users.
	# On the tab Ports alone, as the ports one by one
	[ "$meetings_wanted" = 0 ] || lists="$lists,$(awk -v names="$STATE/users" '
		function q(t) { gsub(/\\/, "\\\\", t); gsub(/"/, "\\\"", t); return "\"" t "\"" }
		function secs(t,    n, all) {
			all = 0
			while (match(t, /^[0-9]+(ms|d|h|m|s)/)) {
				n = substr(t, 1, RLENGTH); t = substr(t, RLENGTH + 1)
				if (n ~ /ms$/) continue
				all += (n ~ /d$/) ? n * 86400 : (n ~ /h$/) ? n * 3600 : (n ~ /m$/) ? n * 60 : n + 0
			}
			return all
		}
		function user(mark,    h, v, i) {
			h = tolower(mark); sub(/^0x/, "", h); v = 0
			for (i = 1; i <= length(h); i++) v = v * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1
			v = int(v / 65536) % 256
			return (v && (v in name)) ? name[v] : "-"
		}
		BEGIN { while ((getline l < names) > 0) { split(l, w, " "); name[w[1]] = (w[3] == "" || w[3] == "-") ? w[2] : w[3] } }
		/^[ 	]*(set|map|chain) / { kind = $2; on = 0; want = (kind == "met" || kind == "port_user0" || kind == "port_user1") }
		want && /elements = \{/ { on = 1; sub(/.*elements = \{/, "") }
		on {
			all = $0; e = index(all, "}")
			if (e) { all = substr(all, 1, e - 1); on = 0 }
			n = split(all, it, ",")
			for (i = 1; i <= n; i++) {
				m = split(it[i], w, " ")
				if (kind == "met" && m >= 7) {
					left = 0
					for (j = 1; j < m; j++) if (w[j] == "expires") left = secs(w[j + 1])
					ago = 86400 - left; p = w[1]
					if (!(p in best) || ago < best[p]) { best[p] = ago; from[p] = w[3] ":" w[5]; by[p] = user(w[7]) }
				} else if ((kind == "port_user0" || kind == "port_user1") && m >= 3) {
					u = user(w[m])
					# kept, written at the end: not gathered in a string, that grows with the square of its length
					if (u != "-" && marks < 1000) { marks++; mport[marks] = w[1] + 0; muser[marks] = u }
				}
			}
		}
		END {
			printf "\"used\":["
			for (p in best)
				if (++shown <= 1000)
					printf "%s{\"port\":%d,\"ago\":%d,\"from\":%s%s}", (shown > 1 ? "," : ""), p, best[p], q(from[p]), (by[p] != "-" ? ",\"user\":" q(by[p]) : "")
			printf "],\"marked\":["
			for (i = 1; i <= marks; i++) printf "%s{\"port\":%d,\"user\":%s}", (i > 1 ? "," : ""), mport[i], q(muser[i])
			printf "]"
		}' "$table.used")"

	# the users of ports that have a limit: the kilobytes their meetings carried, and their limit - from the quotas a_<key> of the
	# table. Nothing is counted of a user without a limit: it is not here, nor is a user of a read key
	json_add_array users
	while read -r key name kb limit; do
		[ -n "$key" ] || continue
		json_add_object
		json_add_string key "$key"
		json_add_string name "$name"
		json_add_double kbytes "$kb"
		[ "$limit" != - ] && json_add_double limit "$limit"
		json_close_object
	done <<-EOF
	$(awk -v names="$STATE/users" '
		function bytes(n, u) { return n * (u == "kbytes" ? 1024 : u == "mbytes" ? 1048576 : u == "gbytes" ? 1073741824 : 1) }
		BEGIN { while ((getline l < names) > 0) { split(l, w, " "); name[w[2]] = w[3] } }
		/^[ 	]*(quota|counter) a_/ { key = substr($2, 3); next }
		key != "" {
			used = 0; limit = "-"
			for (i = 1; i < NF; i++) {
				if ($i == "over") limit = int(bytes($(i + 1), $(i + 2)) / 1048576)
				if ($i == "used") used = bytes($(i + 1), $(i + 2))
				if ($1 == "packets" && $i == "bytes") used = $(i + 1)
			}
			# %.0f: %d of busybox is of 32 bits, and turns over past 2 TiB
			printf "%s %s %.0f %s\n", key, ((key in name) ? name[key] : "-"), int(used / 1024), limit
			key = ""
		}' "$table.users")
	EOF
	json_close_array

	# the log is turned on: its sets are in the table. Off, nothing was noted, and nothing is looked for. Not shown, its sets are
	# not read: whether there is the first of them - 256 elements at most
	log=0
	if [ "$tries_wanted" = 1 ]; then grep -q 'set t_asked' "$table.log" && log=1
	else nft list set ip adhoc_relay t_asked >/dev/null 2>&1 && log=1
	fi
	json_add_boolean log "$log"
	if [ "$tries_wanted" = 1 ]; then
	# the newest first; the page shows 30
	lists="$lists,$( { [ "$log" = 0 ] || cat "$table" "$table.log" | tries | sort -n; } | awk '
		function q(t) { gsub(/\\/, "\\\\", t); gsub(/"/, "\\\"", t); return "\"" t "\"" }
		BEGIN { printf "\"tries\":[" }
		$2 == "T" { if (++n <= 30) printf "%s{\"ago\":%d,\"from\":%s,\"port\":%d,\"what\":%s}", (n > 1 ? "," : ""), $1, q($3), $4, q($5) }
		END { printf "],\"tries_all\":%d", n }')"
	fi

	# the times of the files are those of the clock: seconds since, never below 0
	now=$(date +%s)
	json_add_array records
	[ -f "$STATE/records" ] && while read -r name ip at; do
		since "$at" || continue
		json_add_object
		json_add_string name "$name"
		json_add_string address "$ip"
		json_add_int ago "$s"
		json_close_object
	done < "$STATE/records"
	json_close_array

	json_add_array reports
	[ -f "$STATE/reports" ] && while read -r to sent answered seen; do
		[ -n "$seen" ] || continue
		json_add_object
		json_add_string to "$to"
		[ "$sent" != 0 ] && since "$sent" && json_add_int sent "$s"
		[ "$answered" != 0 ] && since "$answered" && json_add_int answered "$s"
		[ "$seen" != - ] && json_add_string seen "$seen"
		json_close_object
	done < "$STATE/reports"
	json_close_array

	# what the functions of the shell made, an object, and the lists after its last member
	out=$(json_dump)
	printf '%s, %s }\n' "${out%\}}" "$lists"
}

# seconds from the unix time $1 to $now, in $s: no process for it; 1 - $1 is no time
since() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	s=$((now - $1))
	[ "$s" -ge 0 ] || s=0
}

case "$1" in
address) address ;;
status) status "$2" ;;
*) echo "usage: state address|status [asked]" >&2; exit 2 ;;
esac
