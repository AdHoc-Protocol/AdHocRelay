#!/bin/sh
# What this router is now, as JSON: the page of LuCI ( rpcd ) and `adhoc-relay api get` take it from here alike.
# `state address` - the public address of this router, for the line of the server: `address`, that of its wan when it is public,
# else the one the internet sees it at ( public.uc, STUN ) - then `wan` is the address of its wan too: something in front of the
# router, another router or the NAT of the provider, must forward the range to it.
# `state status` - what it does now:
#   running   the rules are loaded
#   giving    `give` runs: servers get ports
#   missing   the packages of OpenWrt it needs and waits for, when there are: they come once the router reaches them
#   ports     the ports given: the port, the address of the server - the last that knocked with the id the port is given to - its state - held ( closed ), open, or open and
#             A dials it ( from where ) - and when it is free again unless A knocks
#   meetings  the connections that met: the port, the client, the server, the state, the bytes when the kernel counts them
#   blocked   the addresses blocked for wrong requests or knocks, and those blocked at a port for guessing passwords there - `port`
#             -, and when the block ends
#   tries     what came in the last 10 minutes, the newest first, 30 at most: seconds ago, from - address and source port - the
#             port of the range, and what - request, knock ( with the id the port is given to ), stranger ( a knock with another
#             id ), wrong ( password ), blocked ( the address is blocked ), dial-a ( a SYN of an address that knocked with the id ),
#             dial ( a SYN of another ), guessing ( a SYN of an address blocked at that port for guessing ), wrote ( a meeting
#             point of a changing address wrote its address ), read ( a server read an address ), call ( a client called a
#             server, to meet it directly ); `tries_all` - how many there are in all
#   records   the addresses relays of changing addresses wrote here, as `give` keeps them: the name of the record, the
#             address, seconds since the last write
#   reports   the relays this router writes its own address to: where, seconds since the last write and since the last
#             answer - none, never - and the address of this router as that relay saw it
# A time to the end of something - `free`, `ends` - is as nft writes it, cut to seconds: 1m3s.

. /usr/share/libubox/jshn.sh

# what `give` keeps of the records and the reports, rewritten as they change
STATE=/tmp/adhoc-relay

# the sets of the table as nft lists it, in one pass: "P <port> <free in> <the server or -> <held|open|dialing> <dials from or ->"
# for each port given, then "B <address> <blocked for> <port or ->" for each blocked one - at a port: it guessed passwords there. What `expires` says is cut to seconds: "52s880ms" ->
# "52s"
sets() {
	awk '
		function items(name, all,    n, it, i, m, w, j, left) {
			n = split(all, it, ",")
			for (i = 1; i <= n; i++) {
				m = split(it[i], w, " ")
				if (m == 0) continue
				left = "-"
				for (j = 1; j < m; j++) if (w[j] == "expires") { left = w[j + 1]; sub(/[0-9]+ms$/, "", left); if (left == "") left = "0s" }
				if (name == "given") { pg++; port[pg] = w[1]; free[pg] = left }
				else if (name == "holder") owner[w[1]] = w[3] # port . address
				else if (name == "open") opened[w[1]] = 1
				else if (name == "seen") { if (!(w[1] in a)) a[w[1]] = w[3] ":" w[5] } # port . address . source port
				else if (name == "blocked") { pb++; address[pb] = w[1]; ends[pb] = left; at[pb] = "-" }
				else if (name == "guessing") { pb++; address[pb] = w[1]; ends[pb] = left; at[pb] = w[3] } # address . port
			}
		}
		$1 == "set" || $1 == "map" || $1 == "chain" { name = $1 == "set" ? $2 : "" }
		/elements = \{/ { on = 1; all = ""; sub(/.*elements = \{/, "") }
		on { all = all " " $0; if (index($0, "}")) { on = 0; sub(/\}.*/, "", all); items(name, all) } }
		END {
			for (i = 1; i <= pg; i++) {
				p = port[i]
				state = !(p in opened) ? "held" : (p in a) ? "dialing" : "open"
				print "P", p, free[i], ((p in owner) ? owner[p] : "-"), state, ((state == "dialing") ? a[p] : "-")
			}
			for (i = 1; i <= pb; i++) print "B", address[i], ends[i], at[i]
		}'
}

# the sets t_* of the table, each element a line "<seconds ago> T <address:source port> <port> <what>", in no order: the seconds
# first, as the sort of busybox sorts by the start of a line only. A set of them lives 10 minutes: the time since is 600 s less what
# `expires` says
tries() {
	awk '
		function secs(t,    n, all) {
			all = 0
			while (match(t, /^[0-9]+(ms|d|h|m|s)/)) {
				n = substr(t, 1, RLENGTH); t = substr(t, RLENGTH + 1)
				if (n ~ /ms$/) continue
				all += (n ~ /d$/) ? n * 86400 : (n ~ /h$/) ? n * 3600 : (n ~ /m$/) ? n * 60 : n + 0
			}
			return all
		}
		function items(name, all,    n, it, i, m, w, j, left) {
			n = split(all, it, ",")
			for (i = 1; i <= n; i++) {
				m = split(it[i], w, " ")
				if (m == 0) continue
				left = 0
				for (j = 1; j < m; j++) if (w[j] == "expires") left = secs(w[j + 1])
				if (name == "holder") owner[w[1] " " w[3]] = 1 # port . address
				else if (name == "blocked") blocked[w[1]] = 1
				else if (name == "guessing") guessing[w[1] " " w[3]] = 1 # address . port
				else if (name ~ /^t_/) { t++; kind[t] = name; ago[t] = 600 - left; addr[t] = w[1]; from[t] = w[1] ":" w[3]; port[t] = w[5] } # address . source port . port
			}
		}
		$1 == "set" || $1 == "map" || $1 == "chain" { name = $1 == "set" ? $2 : "" }
		/elements = \{/ { on = 1; all = ""; sub(/.*elements = \{/, "") }
		on { all = all " " $0; if (index($0, "}")) { on = 0; sub(/\}.*/, "", all); items(name, all) } }
		END {
			for (i = 1; i <= t; i++) {
				k = kind[i]; mine = (port[i] " " addr[i]) in owner
				if (k == "t_asked") k = "request"
				else if (k == "t_wrote") k = "wrote"
				else if (k == "t_read") k = "read"
				else if (k == "t_called") k = "call"
				else if (k == "t_knocked") k = mine ? "knock" : "stranger"
				else if (k == "t_refused") k = (addr[i] in blocked) ? "blocked" : "wrong"
				else k = mine ? "dial-a" : ((addr[i] " " port[i]) in guessing) ? "guessing" : "dial"
				print ago[i], "T", from[i], port[i], k
			}
		}'
}

address() {
	wan=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
	json_init
	case "$wan" in
	# none, or of a private network, or of the NAT of a provider ( 100.64.0.0/10 ): the internet sees the router otherwise
	''|10.*|127.*|169.254.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*)
		json_add_string address "$(ucode /usr/libexec/adhoc-relay/public.uc 2>/dev/null)"
		[ -n "$wan" ] && json_add_string wan "$wan"
		;;
	*)
		json_add_string address "$wan"
		;;
	esac
	json_dump
}

status() {
	json_init
	if ! table=$(nft list table ip adhoc_relay 2>/dev/null); then
		json_add_boolean running 0
		json_dump
		return
	fi
	json_add_boolean running 1
	if pgrep -f 'adhoc-relay/give.uc' >/dev/null; then json_add_boolean giving 1; else json_add_boolean giving 0; fi
	# the packages it needs are being installed: right after an install by the page of LuCI, before the router reaches the internet
	missing=$(/usr/libexec/adhoc-relay/needs 2>/dev/null)
	[ -n "$(echo $missing)" ] && json_add_string missing "$(echo $missing)"

	# the loops read here-documents, not pipes: a loop in a pipe runs in a subshell, and what it adds to the JSON is lost
	json_add_array ports
	array=ports
	while read -r tag one two three four five; do
		case "$tag" in
		P)
			json_add_object
			json_add_int port "$one"
			json_add_string free "$two"
			[ "$three" != - ] && json_add_string a "$three"
			json_add_string state "$four"
			[ "$five" != - ] && json_add_string dials "$five"
			json_close_object
			;;
		B)
			if [ "$array" = ports ]; then
				json_close_array
				json_add_array blocked
				array=blocked
			fi
			json_add_object
			json_add_string address "$one"
			json_add_string ends "$two"
			[ -n "$three" ] && [ "$three" != - ] && json_add_int port "$three"
			json_close_object
			;;
		esac
	done <<-EOF
	$(printf '%s\n' "$table" | sets)
	EOF
	json_close_array
	# none blocked: the list is there all the same, empty
	if [ "$array" = ports ]; then
		json_add_array blocked
		json_close_array
	fi

	json_add_array meetings
	# the connections of the mark of AdHoc Relay: the original direction is the client to the relay, the reply comes from the server
	# the number of a user in the mark - bits 16-23 - is the name of $STATE/users
	meetings=$(awk -v names="$STATE/users" '
		BEGIN { while ((getline l < names) > 0) { split(l, w, " "); name[w[1]] = w[3] } }
		/ tcp / && match($0, /mark=[0-9]+/) {
			mark = substr($0, RSTART + 5, RLENGTH - 5) + 0
			if (and(mark, 134217728) == 0) next
			n = 0; s = 0; bytes = ""
			for (i = 1; i <= NF; i++) {
				split($i, kv, "=")
				if (kv[1] == "src") { n++; src[n] = kv[2] }
				else if (kv[1] == "sport") sport[n] = kv[2]
				else if (kv[1] == "dport") dport[n] = kv[2]
				else if (kv[1] == "bytes") { s += kv[2]; bytes = s }
			}
			id = and(mark, 16711680) / 65536
			# the client is of the way there - or, met the other way round ( 0x02000000 ), of the way back
			c = and(mark, 33554432) ? 2 : 1; v = 3 - c
			print dport[1], src[c] ":" sport[c], src[v] ":" sport[v], $6, (bytes == "" ? "-" : bytes), (id && (id in name) ? name[id] : "-")
		}' /proc/net/nf_conntrack 2>/dev/null)
	while read -r port b a state bytes user; do
		[ -n "$port" ] || continue
		json_add_object
		json_add_int port "$port"
		json_add_string b "$b"
		json_add_string a "$a"
		json_add_string state "$state"
		[ "$bytes" != - ] && json_add_double bytes "$bytes"
		[ "$user" != - ] && json_add_string user "$user"
		json_close_object
	done <<-EOF
	$meetings
	EOF
	json_close_array

	# The ports: when each was used last - its newest meeting of the last day, of the set met -, the client, and the user when
	# the meeting was of one; "U <port> <seconds ago> <client> <user or ->". And the user each port given is marked with now, of
	# the map port_user: "M <port> <user>". The number of a user is bits 16-23 of a mark, its name in $STATE/users
	used=$(printf '%s\n' "$table" | awk -v names="$STATE/users" '
		function secs(t,    n, all) {
			all = 0
			while (match(t, /^[0-9]+(ms|d|h|m|s)/)) {
				n = substr(t, 1, RLENGTH); t = substr(t, RLENGTH + 1)
				if (n ~ /ms$/) continue
				all += (n ~ /d$/) ? n * 86400 : (n ~ /h$/) ? n * 3600 : (n ~ /m$/) ? n * 60 : n + 0
			}
			return all
		}
		function user(mark,    h, v, i) {
			h = tolower(mark); sub(/^0x/, "", h); v = 0
			for (i = 1; i <= length(h); i++) v = v * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1
			v = int(v / 65536) % 256
			return (v && (v in name)) ? name[v] : "-"
		}
		BEGIN { while ((getline l < names) > 0) { split(l, w, " "); name[w[1]] = (w[3] == "" || w[3] == "-") ? w[2] : w[3] } }
		$1 == "set" || $1 == "map" || $1 == "chain" { kind = $2 }
		/elements = \{/ { on = 1; all = ""; sub(/.*elements = \{/, "") }
		on {
			all = all " " $0
			if (!index($0, "}")) next
			on = 0; sub(/\}.*/, "", all)
			n = split(all, it, ",")
			for (i = 1; i <= n; i++) {
				m = split(it[i], w, " ")
				if (kind == "met" && m >= 7) {
					left = 0
					for (j = 1; j < m; j++) if (w[j] == "expires") left = secs(w[j + 1])
					ago = 86400 - left; p = w[1]
					if (!(p in best) || ago < best[p]) { best[p] = ago; from[p] = w[3] ":" w[5]; by[p] = user(w[7]) }
				} else if (kind == "port_user" && m >= 3)
					print "M", w[1], user(w[m])
			}
		}
		END { for (p in best) print "U", p, best[p], from[p], by[p] }')
	json_add_array used
	while read -r tag port ago from user; do
		[ "$tag" = U ] || continue
		json_add_object
		json_add_int port "$port"
		json_add_int ago "$ago"
		json_add_string from "$from"
		[ "$user" != - ] && json_add_string user "$user"
		json_close_object
	done <<-EOF
	$used
	EOF
	json_close_array
	json_add_array marked
	while read -r tag port user; do
		[ "$tag" = M ] && [ "$user" != - ] || continue
		json_add_object
		json_add_int port "$port"
		json_add_string user "$user"
		json_close_object
	done <<-EOF
	$used
	EOF
	json_close_array

	# the users of ports: the kilobytes their meetings carried, and their limit - from the quotas and the counters a_<key> of the
	# table. A user of a read key carries nothing, and is not here
	json_add_array users
	while read -r key name kb limit; do
		[ -n "$key" ] || continue
		json_add_object
		json_add_string key "$key"
		json_add_string name "$name"
		json_add_double kbytes "$kb"
		[ "$limit" != - ] && json_add_double limit "$limit"
		json_close_object
	done <<-EOF
	$(printf '%s\n' "$table" | awk -v names="$STATE/users" '
		function bytes(n, u) { return n * (u == "kbytes" ? 1024 : u == "mbytes" ? 1048576 : u == "gbytes" ? 1073741824 : 1) }
		BEGIN { while ((getline l < names) > 0) { split(l, w, " "); name[w[2]] = w[3] } }
		($1 == "quota" || $1 == "counter") && $2 ~ /^a_/ { key = substr($2, 3); next }
		key != "" {
			used = 0; limit = "-"
			for (i = 1; i < NF; i++) {
				if ($i == "over") limit = int(bytes($(i + 1), $(i + 2)) / 1048576)
				if ($i == "used") used = bytes($(i + 1), $(i + 2))
				if ($1 == "packets" && $i == "bytes") used = $(i + 1)
			}
			printf "%s %s %d %s\n", key, ((key in name) ? name[key] : "-"), used / 1024, limit
			key = ""
		}')
	EOF
	json_close_array

	# the newest first; the page shows 30
	all=$(printf '%s\n' "$table" | tries | sort -n)
	json_add_int tries_all "$(printf '%s\n' "$all" | grep -c ' T ')"
	json_add_array tries
	while read -r ago tag from port what; do
		[ "$tag" = T ] || continue
		json_add_object
		json_add_int ago "$ago"
		json_add_string from "$from"
		json_add_int port "$port"
		json_add_string what "$what"
		json_close_object
	done <<-EOF
	$(printf '%s\n' "$all" | head -n 30)
	EOF
	json_close_array

	# the times of the files are those of the clock: seconds since, never below 0
	now=$(date +%s)
	json_add_array records
	while read -r name ip at; do
		[ -n "$at" ] || continue
		json_add_object
		json_add_string name "$name"
		json_add_string address "$ip"
		json_add_int ago "$(since "$at")"
		json_close_object
	done <<-EOF
	$(cat "$STATE/records" 2>/dev/null)
	EOF
	json_close_array

	json_add_array reports
	while read -r to sent answered seen; do
		[ -n "$seen" ] || continue
		json_add_object
		json_add_string to "$to"
		[ "$sent" != 0 ] && json_add_int sent "$(since "$sent")"
		[ "$answered" != 0 ] && json_add_int answered "$(since "$answered")"
		[ "$seen" != - ] && json_add_string seen "$seen"
		json_close_object
	done <<-EOF
	$(cat "$STATE/reports" 2>/dev/null)
	EOF
	json_close_array

	json_dump
}

# seconds from the unix time $1 to $now
since() {
	s=$((now - $1))
	[ "$s" -ge 0 ] || s=0
	echo "$s"
}

case "$1" in
address) address ;;
status) status ;;
*) echo "usage: state address|status" >&2; exit 2 ;;
esac
